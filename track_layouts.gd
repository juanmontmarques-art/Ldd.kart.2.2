class_name TrackLayouts
extends RefCounted

# GERADO por tools/gen_layouts.py - traçados dos mapas extras (Deserto, Gelo, Vulcão).
# "points" = pontos de controle (x, altura, z) da curva Catmull-Rom; o resto são índices de amostra
# (a cada 2,5 m) de abismos, penhascos, pads etc. Veja track_data.gd para o significado.

static func get_layout(map_id: String) -> Dictionary:
    match map_id:
        "deserto":
            return _deserto()
        "gelo":
            return _gelo()
        "vulcao":
            return _vulcao()
    return {}

